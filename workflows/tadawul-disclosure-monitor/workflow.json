      "parameters": {
        "jsCode": "const disclosure = $('Split Disclosures').item.json;\nconst items = $input.all();\n\nlet markdown = '';\nif (items.length && items[0].json && items[0].json.markdown) {\n  markdown = items[0].json.markdown;\n}\n\nlet text = String(markdown).trim();\n\n// ==========================================================\n// كشف الترميز التالف (mojibake)\n// ==========================================================\n// أحيانًا صفحة تداول بترجع بدون charset واضح، فبيتفسر النص\n// العربي غلط كحروف صينية/كورية. لو لقينا نسبة عالية من حروف\n// CJK في نص المفروض يكون عربي بالكامل، ده دليل على تلف.\nconst cjkMatches = text.match(/[\\u4e00-\\u9fff]/g) || [];\nconst isCorrupted = cjkMatches.length > 30;\n\nif (isCorrupted) {\n  return [{\n    json: {\n      ...disclosure,\n      page_text: null,\n      extraction_note: 'تعذر استخراج النص بشكل صحيح (تلف في الترميز) — سيتم الاعتماد على العنوان فقط.'\n    }\n  }];\n}\n\nconst startMarker = 'IssuerAnnouncementDetailsV2Portlet';\nconst endMarker = 'لا تتحمل أي من هيئة السوق المالية';\nconst startIdx = text.indexOf(startMarker);\nconst endIdx = text.indexOf(endMarker);\n\nif (startIdx !== -1 && endIdx !== -1 && endIdx > startIdx) {\n  text = text.slice(startIdx + startMarker.length, endIdx).trim();\n}\n\nconst MAX_CHARS = 6000;\nif (text.length > MAX_CHARS) {\n  text = text.slice(0, MAX_CHARS) + ' ...[truncated]';\n}\n\nreturn [{\n  json: {\n    ...disclosure,\n    page_text: text || null\n  }\n}];"
      },
