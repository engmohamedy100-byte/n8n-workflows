      "parameters": {
        "jsCode": "// Guarantee exactly ONE output item per company, whether Apify returned\n// 0, 1, or several disclosures. This keeps the loop alive even with no results.\nconst companyItem = $('Build Apify Input').first().json;\nconst rawItems = $input.all();\n\nlet disclosures = [];\nfor (const it of rawItems) {\n  if (Array.isArray(it.json)) {\n    disclosures.push(...it.json);\n  } else if (it.json && Object.keys(it.json).length > 0) {\n    disclosures.push(it.json);\n  }\n}\ndisclosures = disclosures.filter(d => d && d.disclosure_url);\n\nreturn [{\n  json: {\n    company_name: companyItem.company_name,\n    ticker: companyItem.ticker,\n    market: companyItem.market,\n    hasDisclosure: disclosures.length > 0,\n    disclosures\n  }\n}];\n"
      },
