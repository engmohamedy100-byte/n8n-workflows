    {
      "parameters": {
        "jsCode": "const html = $input.first().json.data;\n\nconst decoded = html\n  .replace(/&quot;/g, '\"')\n  .replace(/&amp;/g, '&')\n  .replace(/&#39;/g, \"'\")\n  .replace(/&lt;/g, '<')\n  .replace(/&gt;/g, '>');\n\nconst products = [];\n\nconst productMarker = '\"@type\":\"Product\"';\n\nlet position = 0;\n\nwhile (true) {\n  const start = decoded.indexOf(productMarker, position);\n\n  if (start === -1) break;\n\n  // Find the next Product to define this product's section\n  const next = decoded.indexOf(productMarker, start + productMarker.length);\n\n  const section = decoded.substring(\n    start,\n    next === -1 ? decoded.length : next\n  );\n\n  const getValue = (regex) => {\n    const match = section.match(regex);\n    return match ? match[1] : null;\n  };\n\n  const name = getValue(/\"name\":\"([^\"]+)\"/);\n\n  const url = getValue(/\"url\":\"([^\"]+)\"/);\n\n  const image = getValue(/\"image\":\"([^\"]+)\"/);\n\n  const price = getValue(\n    /\"price\":(\\d+(?:\\.\\d+)?)/\n  );\n\n  const currency = getValue(\n    /\"priceCurrency\":\"([^\"]+)\"/\n  );\n\n  const rating = getValue(\n    /\"ratingValue\":([\\d.]+)/\n  );\n\n  const reviewCount = getValue(\n    /\"reviewCount\":(\\d+)/\n  );\n\n  if (name && url) {\n    products.push({\n      name,\n      url,\n      image,\n      price: price ? Number(price) : null,\n      currency,\n      rating: rating ? Number(rating) : null,\n      reviewCount: reviewCount ? Number(reviewCount) : null\n    });\n  }\n\n  position = start + productMarker.length;\n}\n\nreturn products.map(product => ({\n  json: product\n}));"
      },
