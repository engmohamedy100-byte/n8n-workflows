    {
      "parameters": {
        "name": "Uniqe_Order_id",
        "description": "استخدم هذه الأداة مرة واحدة فقط في بداية معالجة أي طلب جديد لتوليد رقم طلب فريد. استخدم نفس الرقم لكل أصناف نفس الطلب.",
        "jsCode": "const now = new Date();\nconst pad = (n) => String(n).padStart(2, '0');\nconst datePart = now.getFullYear().toString().slice(-2) + pad(now.getMonth()+1) + pad(now.getDate()) + pad(now.getHours()) + pad(now.getMinutes()) + pad(now.getSeconds());\nconst randomPart = Math.floor(Math.random() * 90 + 10);\nreturn { order_id: `ORD-${datePart}-${randomPart}` };"
      },
      "id": "unique-order-id",
      "name": "Uniqe_Order_id",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1,
      "position": [
        1200,
        800
      ]
    },
    {
      "parameters": {
        "name": "Check_Multiple_Items",
        "description": "استخدم هذه الأداة مرة واحدة فقط بعد تأكيد العميل لكل أصناف الطلب، لفحص توفر كل الأصناف دفعة واحدة. المدخل: items = [{name, quantity}, ...]. المخرج: confirmed_items و unavailable_items و unmatched_items. يمكن إعادة استدعائها بعد توضيح الأصناف غير المفهومة.",
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "PUT_CHECK_INVENTORY_BATCH_WORKFLOW_ID",
          "mode": "list"
        },
        "workflowInputs": {
