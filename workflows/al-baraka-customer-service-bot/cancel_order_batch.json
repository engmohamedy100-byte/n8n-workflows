    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "PUT_YOUR_SPREADSHEET_ID_HERE",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Inventory",
