      "id": "get-cancel-inventory",
      "name": "Get Inventory Rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        820,
        300
      ],
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "PUT_YOUR_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const orderId = String($('Execute Workflow Trigger').first().json.order_id ?? '').trim();\nconst order = $('Get Order').first().json;\nconst inventory = $input.all().map(e => e.json).filter(r => r.item_name);\n\nconst stop = (result) => [{ json: { can_cancel: false, restocks: [], result } }];\n\nif (!order || !order.order_id) {\n  return stop({ success: false, reason: 'order_not_found', order_id: orderId });\n}\nif (order.status === 'ملغي') {\n  return stop({ success: false, reason: 'already_cancelled', order_id: orderId });\n}\nif (order.status !== 'قيد التحضير') {\n  return stop({ success: false, reason: 'cannot_cancel', status: order.status, order_id: orderId });\n}\n\nconst norm = (s) => String(s ?? '')\n  .replace(/[\\u064B-\\u065F\\u0670\\u0640]/g, '')\n  .replace(/[أإآ]/g, 'ا')\n  .replace(/ى/g, 'ي')\n  .replace(/ة/g, 'ه')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .toLowerCase();\n\nconst latinDigits = (s) => String(s).replace(/[٠-٩]/g, d => '٠١٢٣٤٥٦٧٨٩'.indexOf(d));\n\nconst parts = String(order.items ?? '').split(/[,،]/).map(p => p.trim()).filter(Boolean);\nconst restockByRow = new Map();\nconst not_restocked_items = [];\n\nfor (const part of parts) {\n  const m = latinDigits(part).match(/^(.+?)\\s*(?:×|\\*|\\sx\\s)\\s*(\\d+(?:\\.\\d+)?)$/i);\n  const row = m && inventory.find(r => norm(r.item_name) === norm(m[1]));\n  if (!row) {\n    not_restocked_items.push(part);\n    continue;\n  }\n  const entry = restockByRow.get(row.row_number) || { row, qty: 0 };\n  entry.qty += Number(m[2]);\n  restockByRow.set(row.row_number, entry);\n}\n\nconst restocks = [...restockByRow.values()].map(({ row, qty }) => ({\n  row_number: row.row_number,\n  quantity_available: (Number(row.quantity_available) || 0) + qty\n}));\n\nreturn [{\n  json: {\n    can_cancel: true,\n    restocks,\n    result: { success: true, order_id: orderId, not_restocked_items }\n  }\n}];"
      },
