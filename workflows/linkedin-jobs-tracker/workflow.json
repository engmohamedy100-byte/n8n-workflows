        "mode": "runOnceForEachItem",
        "jsCode": "// === STEP 3: Map each raw Apify job item to the target data model ===\n// Field names confirmed directly from a real Apify dataset sample (snake_case).\n\nconst original = $('Set - Build Apify Input (edit field names here)').item.json;\nconst job = $json;\n\nreturn {\n  json: {\n    job_id: job.job_id || null,\n    job_url: job.job_url || job.apply_url || null,\n    job_title: job.job_title || null,\n    company_name: job.company_name || original.apify_actor_search_query,\n    company_url: job.company_url || null,\n    location: job.location || original.apify_actor_location,\n    time_posted: job.time_posted || null,\n    num_applicants: job.num_applicants || null,\n    salary_range: job.salary_range || null,\n    job_description: job.job_description || null,\n    job_description_raw_html: job.job_description_raw_html || null,\n    seniority_level: job.seniority_level || null,\n    employment_type: job.employment_type || null,\n    linkedin_company_id: original.apify_actor_company_id,\n    linkedin_reported_job_count: original.apify_actor_max_items,\n    scrape_timestamp: new Date().toISOString()\n  }\n};"
      },
