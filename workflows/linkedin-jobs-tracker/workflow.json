    {
      "parameters": {
        "jsCode": "// === STEP 1: Resolve LinkedIn Company ID via the public guest typeahead endpoint ===\n// Endpoint (undocumented but widely used, no login required):\n// https://www.linkedin.com/jobs-guest/api/typeaheadHits?typeaheadType=COMPANY&query=<name>\n\nconst company = ($json['Company Name'] || $json['Company'] || $json.company || '').toString().trim();\nconst location = ($json['Location'] || $json['Country'] || '').toString().trim();\n\nif (!company) {\n  return [{ json: { ...$json, status: 'FAILED', error_message: 'Missing Company in row' } }];\n}\n\nconst url = `https://www.linkedin.com/jobs-guest/api/typeaheadHits?typeaheadType=COMPANY&query=${encodeURIComponent(company)}`;\n\nlet companyId = null;\nlet matchedName = null;\nlet candidates = [];\n\nconst norm = (s) => (s || '').toString().trim().toLowerCase();\n\ntry {\n  const res = await this.helpers.httpRequest({\n    method: 'GET',\n    url,\n    headers: {\n      'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0 Safari/537.36',\n      'Accept': 'application/json'\n    },\n    json: true,\n    timeout: 15000\n  });\n\n  candidates = Array.isArray(res) ? res : (res.items || res.hits || res || []);\n\n  const exact = candidates.find(c => norm(c.displayName || c.text) === norm(company));\n  const chosen = exact || candidates[0];\n\n  if (chosen) {\n    const urn = chosen.trackingUrn || chosen.targetUrn || chosen.urn || chosen.id || '';\n    const match = String(urn).match(/(\\d+)\\s*$/);\n    companyId = match ? match[1] : null;\n    matchedName = chosen.displayName || chosen.text || null;\n  }\n} catch (err) {\n  return [{ json: { ...$json, linkedin_company_id: null, status: 'FAILED', error_message: `Company resolution request failed: ${err.message}` } }];\n}\n\nif (!companyId) {\n  return [{ json: { ...$json, linkedin_company_id: null, status: 'FAILED', error_message: `Company not found on LinkedIn typeahead (0 matches for \"${company}\")` } }];\n}\n\nreturn [{\n  json: {\n    ...$json,\n    location,\n    linkedin_company_id: companyId,\n    matched_company_name: matchedName,\n    company_candidate_count: candidates.length,\n    status: 'RESOLVED'\n  }\n}];"
      },
      "id": "7fe4a48f-4ab0-468b-a13f-7cb119920b29",
      "name": "Code - Resolve Company ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -3584,
        624
      ]
    },
    {
      "parameters": {
        "jsCode": "// ==========================================\n// LINKEDIN JOB COUNT\n// Company + Location + Past 24 Hours\n// ==========================================\n\nif ($json.status === 'FAILED') {\n  return [{ json: $json }];\n}\n\nconst companyId = String(\n  $json.linkedin_company_id || ''\n).trim();\n\nconst location = String(\n  $json.posted_location ||\n  $json.Location ||\n  $json.location ||\n  ''\n).trim();\n\nconst postedWithin =\n  $json.posted_within || 'Past 24 hours';\n\nif (!companyId) {\n  return [{\n    json: {\n      ...$json,\n      status: 'FAILED',\n      error_message: 'Missing linkedin_company_id'\n    }\n  }];\n}\n\nif (!location) {\n  return [{\n    json: {\n      ...$json,\n      status: 'FAILED',\n      error_message: 'Missing location'\n    }\n  }];\n}\n\n\n// ==========================================\n// LinkedIn time filter\n// Past 24 hours = r86400\n// ==========================================\n\nlet timeFilter = '';\n\nif (postedWithin === 'Past 24 hours') {\n  timeFilter = '&f_TPR=r86400';\n}\n\nelse if (postedWithin === 'Past week') {\n  timeFilter = '&f_TPR=r604800';\n}\n\nelse if (postedWithin === 'Past month') {\n  timeFilter = '&f_TPR=r2592000';\n}\n\n\n// ==========================================\n// SETTINGS\n// ==========================================\n\nconst PAGE_SIZE = 10;\nconst MAX_PAGES = 50;\n\nlet start = 0;\n\nconst allJobIds = new Set();\n\nlet pagesChecked = 0;\nlet lastStatus = null;\n\n\n// ==========================================\n// REQUEST\n// ==========================================\n\nasync function fetchPage(url) {\n\n  return await this.helpers.httpRequest({\n\n    method: 'GET',\n\n    url,\n\n    headers: {\n\n      'User-Agent':\n        'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/125.0 Safari/537.36',\n\n      'Accept':\n        'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',\n\n      'Accept-Language':\n        'en-US,en;q=0.9'\n    },\n\n    returnFullResponse: true,\n\n    timeout: 15000\n  });\n}\n\n\n// ==========================================\n// EXTRACT JOB IDS\n// ==========================================\n\nfunction extractJobIds(html) {\n\n  const ids = new Set();\n\n  // urn:li:jobPosting\n  for (\n    const match of html.matchAll(\n      /urn:li:jobPosting:(\\d+)/g\n    )\n  ) {\n    ids.add(match[1]);\n  }\n\n  // data-job-id\n  for (\n    const match of html.matchAll(\n      /data-job-id=[\"'](\\d+)[\"']/g\n    )\n  ) {\n    ids.add(match[1]);\n  }\n\n  // /jobs/view/123456\n  for (\n    const match of html.matchAll(\n      /\\/jobs\\/view\\/(\\d+)/g\n    )\n  ) {\n    ids.add(match[1]);\n  }\n\n  return [...ids];\n}\n\n\n// ==========================================\n// PAGINATION\n// ==========================================\n\nfor (\n  let page = 0;\n  page < MAX_PAGES;\n  page++\n) {\n\n  pagesChecked++;\n\n  const url =\n    'https://www.linkedin.com/jobs-guest/jobs/api/seeMoreJobPostings/search' +\n\n    `?f_C=${encodeURIComponent(companyId)}` +\n\n    `&location=${encodeURIComponent(location)}` +\n\n    timeFilter +\n\n    `&start=${start}`;\n\n\n  try {\n\n    const response =\n      await fetchPage(url);\n\n    lastStatus =\n      response.statusCode ??\n      response.status ??\n      null;\n\n\n    // ======================================\n    // RATE LIMIT / BLOCK\n    // ======================================\n\n    if (\n      lastStatus === 429 ||\n      lastStatus === 403 ||\n      lastStatus === 999\n    ) {\n\n      return [{\n        json: {\n\n          ...$json,\n\n          linkedin_reported_job_count:\n            null,\n\n          linkedin_unique_jobs_found:\n            allJobIds.size,\n\n          status: 'BLOCKED',\n\n          error_message:\n            `LinkedIn returned HTTP ${lastStatus}`,\n\n          pages_checked:\n            pagesChecked\n        }\n      }];\n    }\n\n\n    const html =\n      String(response.body || '');\n\n\n    // ======================================\n    // EXTRACT\n    // ======================================\n\n    const pageJobIds =\n      extractJobIds(html);\n\n\n    console.log(\n      `Page ${page + 1} | ` +\n      `start=${start} | ` +\n      `jobs=${pageJobIds.length}`\n    );\n\n\n    // ======================================\n    // NO JOBS\n    // ======================================\n\n    if (\n      pageJobIds.length === 0\n    ) {\n      break;\n    }\n\n\n    // ======================================\n    // UNIQUE\n    // ======================================\n\n    for (\n      const jobId of pageJobIds\n    ) {\n\n      allJobIds.add(jobId);\n\n    }\n\n\n    // ======================================\n    // END\n    // ======================================\n\n    if (\n      pageJobIds.length < PAGE_SIZE\n    ) {\n      break;\n    }\n\n\n    // ======================================\n    // NEXT PAGE\n    // ======================================\n\n    start += PAGE_SIZE;\n\n\n    // ======================================\n    // DELAY\n    // ======================================\n\n    await new Promise(resolve =>\n      setTimeout(\n        resolve,\n        800 + Math.random() * 700\n      )\n    );\n\n  }\n\n  catch (error) {\n\n    return [{\n      json: {\n\n        ...$json,\n\n        linkedin_reported_job_count:\n          null,\n\n        linkedin_unique_jobs_found:\n          allJobIds.size,\n\n        status: 'FAILED',\n\n        error_message:\n          error.message,\n\n        pages_checked:\n          pagesChecked\n      }\n    }];\n  }\n}\n\n\n// ==========================================\n// FINAL RESULT\n// ==========================================\n\nconst total =\n  allJobIds.size;\n\n\nreturn [{\n  json: {\n\n    ...$json,\n\n    posted_within:\n      'Past 24 hours',\n\n    linkedin_reported_job_count:\n      total,\n\n    linkedin_unique_jobs_found:\n      total,\n\n    pages_checked:\n      pagesChecked,\n\n    status:\n      total > 0\n        ? 'COUNTED'\n        : 'ZERO_JOBS'\n  }\n}];"
      },
      "id": "f8af6079-3330-4ed9-99d8-4fe278392c9b",
      "name": "Code - Count Actual LinkedIn Jobs",
      "type": "n8n-nodes-base.code",
