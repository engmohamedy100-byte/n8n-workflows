    {
      "parameters": {
        "jsCode": "// === STEP 4: Verify LinkedIn count == Apify returned count ===\nconst row = $('Set - Build Apify Input (edit field names here)').item.json;\nconst allJobsField = Object.keys($json).find(k => Array.isArray($json[k])) || 'data';\nconst jobs = $json[allJobsField] || [];\n\nconst linkedinCount = row.apify_actor_max_items;\nconst apifyCount = jobs.length;\nconst match = linkedinCount === apifyCount;\n\nreturn [{\n  json: {\n    company_name: row.apify_actor_search_query,\n    location: row.apify_actor_location,\n    linkedin_company_id: row.apify_actor_company_id,\n    linkedin_reported_job_count: linkedinCount,\n    apify_returned_job_count: apifyCount,\n    verification_status: match ? 'MATCH' : 'MISMATCH',\n    status: match ? 'DONE' : 'FAILED_MISMATCH',\n    error_message: match ? '' : `Count mismatch: LinkedIn=${linkedinCount} vs Apify=${apifyCount}. Possible causes: jobs changed between COUNT and SCRAPE, pagination undercount, or actor input field names need correction.`,\n    scrape_timestamp: new Date().toISOString(),\n    jobs\n  }\n}];\n"
      },
